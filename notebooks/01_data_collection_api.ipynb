# Import required libraries
requests
import pandas as pd
import numpy as np
import datetime

# Rest API requests for SpaceX launches
import requests

spacex_url = "https://api.spacexdata.com/v4/launches/past"
response = requests.get(spacex_url)
data = response.json()

# Parse JSON data into a DataFrame
# (Standard IBM Capstone API data extraction logic)
df = pd.json_normalize(data)
df = df[['rocket', 'payloads', 'launchpad', 'success', 'date_utc', 'flight_number']]

print(f"Data retrieved successfully. Total rows: {df.shape[0]}")
